# Copy to .env and fill private settings. Non-secret Pi settings are in pi.env.
POSTGRES_PASSWORD=
S3_ACCESS_KEY=
S3_SECRET_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_USER_ID=
TELEGRAM_ALLOWED_USER_IDS=
# Key for the OpenCode Go profile in models.toml.
LLM_API_KEY=
# HTTPS origin for the usage-only relay.
LLM_METER_URL=https://llm-meter.example.invalid

# Accept bot messages in allowed groups.
TELEGRAM_ALLOW_BOT_MESSAGES=false

# Optional private owner-only Telegram forum supergroup for Dev Manager workspace.
TELEGRAM_WORKSPACE_GROUP_ID=

# Optional Exa web search API key (Starter plan default budget: $10/month).
EXA_API_KEY=
